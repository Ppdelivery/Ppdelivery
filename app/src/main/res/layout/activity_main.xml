<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="serif"
            android:text="@string/today_is"
            android:textColor="@color/ink_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/today"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:autoSizeMaxTextSize="48sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/ink_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:fontFamily="serif"
            android:text="@string/anchor_label"
            android:textColor="@color/ink_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/month"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants" />

            <NumberPicker
                android:id="@+id/year"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="serif"
            android:text="@string/wording_label"
            android:textColor="@color/ink_muted"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/style_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/style_phone"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/style_classic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/style_classic"
                android:textColor="@color/ink" />
        </RadioGroup>

        <Switch
            android:id="@+id/timely"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/timely"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/timely_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="serif"
            android:text="@string/lock_screen_label"
            android:textColor="@color/ink_muted"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/lock_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="serif"
            android:text="@string/lock_notification"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:text="@string/lock_notification_note"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/set_wallpaper"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="serif"
            android:text="@string/set_wallpaper"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
